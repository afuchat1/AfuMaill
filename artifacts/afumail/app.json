{
  "expo": {
    "name": "AfuMail",
    "slug": "afumail",
    "version": "2.2.24",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "afumail",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "2246",
      "bundleIdentifier": "com.afuchat.afuapp",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "mailto"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "mailto"
        ]
      }
    },
    "android": {
      "package": "com.afuchat.afuapp",
      "versionCode": 2246,
      "blockedPermissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand-icon.png",
        "backgroundColor": "#0D1526"
      },
      "intentFilters": [
        {
          "action": "SENDTO",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "mailto"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D1526"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "afuchat",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9909adfd-c4ca-4e59-98ec-3387dea08688"
      }
    }
  }
}
