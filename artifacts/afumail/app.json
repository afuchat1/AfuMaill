{
  "expo": {
    "name": "AfuMail",
    "slug": "afumail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "afumail",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.afuchat.afuapp",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["mailto"]
          }
        ],
        "LSApplicationQueriesSchemes": ["mailto"]
      }
    },
    "android": {
      "package": "com.afuchat.afuapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FAF8F5"
      },
      "intentFilters": [
        {
          "action": "SENDTO",
          "category": ["DEFAULT"],
          "data": [{ "scheme": "mailto" }]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
