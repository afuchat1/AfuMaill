{
  "expo": {
    "name": "AfuMail",
    "slug": "afumail-web",
    "version": "1.0.0",
    "scheme": "afumail",
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mail.afuchat.com/"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
